{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://food-point-api.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://food-point-api.onrender.com/uploads/$1"
    }
  ]
}

/*
NOTES
- The PWA files live at the published root: /manifest.json, /sw.js, /icons/*, /favicon.svg
- If those paths return 404 after the next deploy, import the repo in the Vercel dashboard and deploy again from Git.
- Do not point /api or /uploads at the Render backend for the PWA assets above.
*/
